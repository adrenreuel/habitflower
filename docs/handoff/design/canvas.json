    "habits_title": {
      "x": 0,
      "y": 1224,
      "text": "2. Habits: home, habit pages by check-in type, edit, pause",
      "kind": "title1",
      "maxW": 6030
    },
    "create_title": {
      "x": 0,
      "y": 4758,
      "text": "4. Create: the + sheet, new habit, new task",
      "kind": "title1",
      "maxW": 1730
    },
    "create_rules": {
      "fill": "green",
      "size": 24,
      "text": "Center + behaviour\n\n- Same sheet on every tab: habit, task, friend\n- The option for the tab you came from goes first (from Tasks: Add a task on top; from Friends: Friend on top)\n- Long-press + skips the sheet and opens that tab's form directly\n- Friends screen loses its own + Add Friend button",
      "w": 320,
      "x": 1410,
      "y": 5018
    },
    "tasks_title": {
      "x": 0,
      "y": 6242,
      "text": "5. Tasks: list, detail, edit",
      "kind": "title1",
      "maxW": 1330
    },
    "friends_title": {
      "x": 0,
      "y": 7922,
      "text": "6. Friends: HabitFlowers, updates, adding and managing friends",
      "kind": "title1",
      "maxW": 2740
    },
    "empty_title": {
      "x": 0,
      "y": 13056,
      "text": "9. Empty states",
      "kind": "title1",
      "maxW": 2270
    },
    "widgets_title": {
      "x": 0,
      "y": 14540,
      "text": "10. iOS widget: My HabitFlowers",
      "kind": "title1",
      "maxW": 1458
    },
    "widget_rules": {
      "fill": "blue",
      "size": 24,
      "text": "Widget states\n\n- Green chevron above the flower: due today\n- Green check: done today\n- Moon: rest day\n- Flower shows its growth stage (sprout, bud, bloom)\n- Faded and drooping: wilting or dried up\n- Tap a flower: opens that habit\n- Tap elsewhere: opens Habits",
      "w": 320,
      "x": 1138,
      "y": 14800
    },
    "flowers_title": {
      "x": 0,
      "y": 15562,
      "text": "11. Flowers: stages and states",
      "kind": "title1",
      "maxW": 1480
    },
    "settings_title": {
      "x": 0,
      "y": 11516,
      "text": "8. Settings: account, notifications, help",
      "kind": "title1",
      "maxW": 2740
    },
    "onboard_title": {
      "x": 0,
      "y": -260,
      "text": "1. First launch: welcome, notifications",
      "kind": "title1",
      "maxW": 1260
    },
    "onboard_rules": {
      "fill": "green",
      "size": 24,
      "text": "Accounts\n\n- First launch creates an anonymous account, no sign-in\n- Welcome, then notifications, then the Home empty state (no first-habit form)\n- Ask to back up after the first bloom and in Account\n- Friends and grow together need a username and Apple or Google first\n- Unlinked accounts are lost if the app is deleted",
      "w": 320,
      "x": 940,
      "y": 0
    },
    "activity_title": {
      "kind": "title1",
      "x": 0,
      "y": 10032,
      "text": "7. Activity: requests and notifications",
      "maxW": 600
    },
    "growth_rules": {
      "fill": "yellow",
      "size": 24,
      "text": "Growth moments\n\n- Only when the state changes: new stage, bloom milestone (7, 30, 100 days), recovered, revived\n- Plain check-ins: a quick bounce and a haptic, no overlay\n- Old state shrinks away, new one springs in, with soft rays and falling confetti in the flower's colour\n- Button uses the flower's colour\n- Reduce Motion: cross-fade only",
      "w": 320,
      "x": 2820,
      "y": 3534
    },
    "growth_title": {
      "x": 0,
      "y": 3274,
      "text": "3. Growth moments: shown only when a flower changes state",
      "kind": "title1",
      "maxW": 3140
    },
