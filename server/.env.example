# Copy to .env on the server (chmod 600). Never commit .env.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long
APPLE_BUNDLE_ID=com.habitflower.app
# Comma-separated Google OAuth client ids (iOS, web)
GOOGLE_CLIENT_IDS=
# Nightly backups (scripts/backup.sh)
BACKUP_S3_URI=s3://your-bucket/habitflower
